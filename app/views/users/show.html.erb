<h1>My Checking Account</h1>
<hr>
<br>
<h3>Current Balance: $<%= @user.balance %></h3>

<%= bootstrap_form_with model: @user, url: user_path(@user), method: :patch, data: { turbo: false } do |f| %>
    <%= f.number_field(:balance, label: "Enter New Balance") %>
    <%= f.submit "Update Balance" %>

<% end %>