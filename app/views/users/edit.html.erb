<h1>Update User Details</h1>
 
<%= bootstrap_form_with model: @user, url: user_path(@user), method: :patch, data: { turbo: false } do |f| %>
 
  <%= f.text_field :name %>
  <%= f.text_field :address %>
  <%= f.text_field :email %>
  <%= f.text_field :phone %>
  <%= f.text_field :balance %>
  <%= f.submit %>
 
<% end %>