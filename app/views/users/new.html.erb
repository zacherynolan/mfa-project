<h1>New User Registration</h1>
 
<%= bootstrap_form_with model: @user, url: users_path, method: :post, data: { turbo: false } do |f| %>
 
  <%= f.text_field :name %>
  <%= f.text_field :address %>
  <%= f.text_field :email %>
  <%= f.text_field :phone %>
  <%= f.text_field :balance %>
  <%= f.text_field :password %>
  <%= f.submit %>
 
<% end %>